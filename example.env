# 로컬 개발용 환경변수 예시.
# 사용법: 이 파일을 repo 루트에 `.env` 로 복사해서 값을 바꾼다 (`.env` 는 git에 올리지 않는다).
# 복사하지 않아도 docker-compose.yml 과 application.properties 의 기본값으로 바로 동작한다.

# --- 로컬 PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=board
POSTGRES_USER=board
POSTGRES_PASSWORD=board
POSTGRES_PORT=5432

# --- 백엔드 (backend/src/main/resources/application.properties) ---
DB_URL=jdbc:postgresql://localhost:5432/board
DB_USERNAME=board
DB_PASSWORD=board
# PostgreSQL 오류 Detail(키 값 등 개인정보)을 예외·로그에 싣는다. 기본 false — 로컬 디버깅 때만 true.
# DB_LOG_SERVER_ERROR_DETAIL=true
# DB 타임아웃 (TASK-23#1). 비우면 기본값: 커넥션 대기 5000ms, 소켓 무응답 10초, lock_timeout 5s, statement_timeout 5s, transaction_timeout 10s
# (커넥션 대기 + transaction_timeout + 소켓 무응답이 30초 안이어야 DB 장애·과부하 중에도 응답이 30초 안에 끝난다.
#  statement_timeout 은 소켓 타임아웃·transaction_timeout 보다 짧게. transaction_timeout 은 PostgreSQL 17+)
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_SOCKET_TIMEOUT_SECONDS=10
# DB_LOCK_TIMEOUT=5s
# DB_STATEMENT_TIMEOUT=5s
# DB_TRANSACTION_TIMEOUT=10s

# --- 인증 (TASK-2) ---
# 자체 서명 JWT 의 HS256 키. 32바이트 이상. 주석으로 두면 개발용 기본값(운영 금지)을 쓴다.
# 빈 값(JWT_SECRET=)으로 두면 기본값 대신 빈 문자열이 들어가 기동이 실패하니 주석을 풀 때는 값을 채운다.
# JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# HTTPS 운영에서는 true (SESSION·XSRF-TOKEN 쿠키에 Secure)
COOKIE_SECURE=false

# --- 인증 (TASK-3) ---
# 첫 ADMIN: 백엔드가 기동할 때 ADMIN 이 하나도 없고 이 이메일(대소문자 무시)의 LOCAL 계정이 이미 있으면 ADMIN 으로 올린다(1회성).
# 가입만으로는 ADMIN 이 되지 않는다 — 이 이메일로 가입한 뒤 백엔드를 다시 시작한다. 승격되면 비운다. 소셜·휴대폰 계정의 이메일은 보지 않는다.
ADMIN_EMAIL=
# refresh 토큰 수명(ISO-8601 기간). 주석이면 기본 P14D(14일). access 토큰은 15분 고정.
# JWT_REFRESH_TTL=P14D

# --- 소셜 로그인 (TASK-4) ---
# 브라우저가 보는 공개 주소(끝 / 없이). OAuth redirect-uri 와 로그인 후 프론트 리다이렉트를 이 값으로 만든다.
# 기본 http://localhost:3000 (Next 개발 서버가 /api 를 백엔드로 프록시한다는 가정). 프론트 없이 백엔드만 시험하려면
# http://localhost:8080 으로 두고 제공자 콘솔에도 그 주소의 콜백을 등록한다. 운영: https://<cloudfront 또는 도메인>
PUBLIC_BASE_URL=http://localhost:3000
# 제공자 콘솔에 등록할 redirect URI: ${PUBLIC_BASE_URL}/api/login/oauth2/code/google , .../github , .../naver , .../kakao , .../cognito
# 비워 두면 그 제공자는 등록하지 않는다(앱은 그대로 뜨고, 시작하면 ?error=unknown_provider).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Naver (TASK-5): Naver Developers → 애플리케이션 → Client ID / Client Secret. 콜백 .../code/naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Kakao (TASK-5): Kakao Developers → 앱 키의 REST API 키 / 카카오 로그인 → 보안 → Client Secret. 콜백 .../code/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Cognito (TASK-6, OIDC): Terraform infra/main/modules/cognito 출력 → client_id / client_secret / issuer_uri / domain_url.
# 콜백 .../code/cognito 는 모듈이 public_base_url 로 App Client 에 등록한다. client-id 를 주면 ISSUER_URI·DOMAIN 도 필요하다.
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# https://cognito-idp.<region>.amazonaws.com/<user pool id>
COGNITO_ISSUER_URI=
# Hosted UI 주소 https://<domain_prefix>.auth.<region>.amazoncognito.com
COGNITO_DOMAIN=
# 제공자 HTTP 호출(토큰·userinfo·JWKS) 연결·읽기 타임아웃 (TASK-25#3). 비우면 3s / 5s
# OAUTH_HTTP_CONNECT_TIMEOUT=3s
# OAUTH_HTTP_READ_TIMEOUT=5s

# --- 휴대폰 OTP (TASK-7) ---
# SMS 발송: console(기본, 인증번호를 백엔드 로그로만 남김(번호는 마스킹) — 운영 모드(https)면 기동 실패) | memory(테스트) | aws(End User Messaging SMS)
SMS_PROVIDER=console
# + 없이 들어온 번호를 해석할 지역 (E.164 정규화)
SMS_DEFAULT_REGION=KR
# SMS 를 보낼 수 있는 번호의 지역(쉼표로 여럿). 이 지역의 휴대폰만 — 그 밖은 400 phone_not_allowed (TASK-22#4)
SMS_ALLOWED_REGIONS=KR
# SMS_PROVIDER=aws 일 때: 리전, 발신 identity(발신 번호·sender ID·phone pool ARN, 비우면 계정 기본), configuration set(선택).
# 자격 증명은 EC2 인스턴스 프로파일(IAM sms-voice:SendTextMessage).
SMS_AWS_REGION=us-east-1
SMS_ORIGINATION_IDENTITY=
SMS_CONFIGURATION_SET=
# SMS_PROVIDER=aws 일 때 SendTextMessage 호출 전체(재시도 포함)·시도별 타임아웃 (TASK-25#4). 비우면 10s / 4s. 넘으면 503 sms_unavailable
# SMS_API_CALL_TIMEOUT=10s
# SMS_API_CALL_ATTEMPT_TIMEOUT=4s
# OTP 코드 해시(HMAC-SHA256) 키. 32바이트 이상. 주석으로 두면 개발용 기본값(운영 금지)을 쓴다.
# 빈 값(OTP_HASH_KEY=)으로 두면 기동이 실패하니 주석을 풀 때는 값을 채운다.
# OTP_HASH_KEY=change-me-to-another-random-string-of-at-least-32-bytes
# 발송 한도: 같은 번호 24시간 N회, 같은 클라이언트 IP 1시간 M회 (같은 번호 60초 1회는 고정)
OTP_PHONE_DAILY_LIMIT=10
OTP_IP_HOURLY_LIMIT=20
# 레이트리밋 (TASK-22, 비우면 앱 기본값). 창은 고정: 로그인 계정 15분·IP 1시간, 가입 IP 1시간, 글 1분/1시간, 댓글 1분, presign 1시간
# RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
# RATE_LIMIT_LOGIN_IP_MAX=30
# RATE_LIMIT_SIGNUP_IP_MAX=10
# RATE_LIMIT_POST_MINUTE_MAX=3
# RATE_LIMIT_POST_HOUR_MAX=30
# RATE_LIMIT_COMMENT_MAX=10
# RATE_LIMIT_PRESIGN_MAX=60
# RATE_LIMIT_MAX_PENDING_ATTACHMENTS=20
# 클라이언트 IP 신뢰 헤더. 로컬은 비워 둔다(remote address). CloudFront 뒤(운영)는 CloudFront-Viewer-Address.
CLIENT_IP_HEADER=

# --- 이미지 첨부 (TASK-11) ---
# 로컬 MinIO (docker-compose.yml, `make dev-storage`). 콘솔 http://localhost:9001 (아래 루트 계정으로 로그인)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 백엔드 업로드 설정. UPLOADS_BUCKET 을 비우면 업로드 기능이 꺼진다(앱은 뜨고 presign·confirm 은 503 uploads_unavailable).
# 아래 값은 로컬 MinIO 기준. 운영(S3)은 버킷·리전만 주고 ENDPOINT·PATH_STYLE·ACCESS/SECRET 은 비운다(EC2 인스턴스 프로파일).
UPLOADS_BUCKET=board-uploads
UPLOADS_REGION=us-east-1
UPLOADS_ENDPOINT=http://localhost:9000
UPLOADS_PATH_STYLE=true
UPLOADS_ACCESS_KEY=minioadmin
UPLOADS_SECRET_KEY=minioadmin
# 첨부 공개 URL 앞부분(+ 키에서 uploads/ 뒤). 로컬은 MinIO 의 익명 읽기 경로, 운영은 CloudFront 의 /uploads/
UPLOADS_PUBLIC_BASE_PATH=http://localhost:9000/board-uploads/uploads/
# 글에서 뗀·붙이지 않은 확정 첨부와 삭제된 글의 첨부를 지우기 전 유예 기간 (TASK-26#4, 비우면 P7D). 이 안에 글을 복구하면 이미지가 그대로다
# UPLOADS_ORPHAN_GRACE_PERIOD=P7D
# S3 호출 하나의 전체(재시도 포함)·시도별 타임아웃 (TASK-26#3, 비우면 5s / 2s). 넘거나 S3 오류면 503 storage_unavailable
# UPLOADS_API_CALL_TIMEOUT=5s
# UPLOADS_API_CALL_ATTEMPT_TIMEOUT=2s
# 스케줄 작업(첨부 정리) 분산 락의 최소 유지 시간 (TASK-26#5, 비우면 PT10S)
# SCHEDULING_LOCK_AT_LEAST_FOR=PT10S
# 보존 기간 정리 (TASK-27#1, 비우면 PT1H / P7D / P1D): 주기, 끝난 refresh 토큰 family 보존(살아 있는 family 는 지우지 않는다), 만료된 OTP 챌린지 보존(발송 한도 창 24시간보다 먼저 지우지는 않는다)
# RETENTION_INTERVAL=PT1H
# REFRESH_TOKEN_RETENTION=P7D
# OTP_RETENTION=P1D

# OS / 에디터
.DS_Store
.idea/
.vscode/
*.iml
*.swp

# 비밀값 — 실제 값은 example.env를 복사한 .env에만 둔다
.env
.env.*
*.pem
*.p12
*.jks
*.keystore

# backend (Gradle)
backend/.gradle/
backend/build/
backend/bin/
backend/out/
!backend/gradle/wrapper/gradle-wrapper.jar

# frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
# 재사용 모듈은 provider 버전을 범위(~>)로만 두고 lock 파일을 커밋하지 않는다. 실제 버전 고정은 루트 스택(infra/bootstrap, infra/main)의 lock 파일이 한다.
infra/main/modules/**/.terraform.lock.hcl

# 로그
*.log
